{
  "name": "zephyr-devicetree-companion",
  "version": "0.0.1",
  "description": "LSP proxy in front of devicetree-language-server: Zephyr workspace and build discovery for Zed",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/companion.cjs --legal-comments=inline",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "20.19.17",
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
